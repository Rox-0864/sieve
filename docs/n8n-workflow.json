{
  "name": "Sieve — Pipeline (Webhook → HTTP → IF → Response)",
  "notes": "Template de n8n para orquestar Sieve. Importar en n8n y ajustar la URL base de la API (por defecto http://localhost:8000). El flujo corre las etapas de máquina: analizar y generar. La curaduría sigue siendo del panel humano (M6), y la publicación se dispara aparte con POST /publicar.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lote",
        "responseMode": "onReceived"
      },
      "name": "Webhook (recibe lote)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/analizar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}"
      },
      "name": "Analizar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/generar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "perfil", "value": "one" }
          ]
        }
      },
      "name": "Generar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "number" },
          "conditions": [
            {
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "¿Hay activos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [880, 0]
    }
  ],
  "connections": {
    "Webhook (recibe lote)": {
      "main": [[{ "node": "Analizar", "type": "main", "index": 0 }]]
    },
    "Analizar": {
      "main": [[{ "node": "Generar", "type": "main", "index": 0 }]]
    },
    "Generar": {
      "main": [[{ "node": "¿Hay activos?", "type": "main", "index": 0 }]]
    },
    "¿Hay activos?": {
      "main": [
        [{ "node": "Responder", "type": "main", "index": 0 }],
        []
      ]
    }
  }
}
