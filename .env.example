# =============================================================
# Sieve — variables de entorno
#
# COPIAR ESTE ARCHIVO y renombrarlo a .env
#   cp .env.example .env
#
# .env esta en .gitignore. NUNCA commitearlo.
# =============================================================


# ─── PROVEEDOR DE LLM ───────────────────────────────────────
# Determina que adapter se usa en src/sieve/llm/factory.py
# Valores validos: gemini | openai | anthropic | ollama
# Elegir el proveedor NO obliga a cambiar codigo: es una variable,
# no una dependencia hardcodeada. Si un dia el free tier de tu
# proveedor falla, cambias esta linea y el proyecto sigue andando.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Para ollama (modelos locales, sin costo, sin enviar datos afuera)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1


# ─── MODELO ────────────────────────────────────────────────
# Usar un modelo de respuesta rapida para analizar y uno con
# mejor redaccion para generar. El analisis no necesita un
# modelo caro; la prosa si.
LLM_ANALYSIS_MODEL=
LLM_WRITER_MODEL=

# Temperatura. Baja = mas deterministico (mejor para tests y para
# que el scoring sea reproducible). Alta = mas creativo.
# La prosa de marketing se BENEFICIA de algo de variedad.
LLM_ANALYSIS_TEMPERATURE=0.0
LLM_WRITER_TEMPERATURE=0.7


# ─── ORACLE CLOUD INFRASTRUCTURE ───────────────────────────
# OJO: la API key va en ~/.oci/config (fuera del repo), NO aqui.
# Solo la referencia al path.
OCI_CONFIG_PATH=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=

# Bucket Always Free para los activos generados.
OCI_BUCKET=communitylab-activos-marketing

# Prefijo de las rutas de objetos dentro del bucket.
OCI_PREFIX=activos


# ─── APP ───────────────────────────────────────────────────
# Numero maximo de interacciones procesadas por lote.
# Protege contra un archivo Gigabyte que te reviente la billetera
# de la API y tu limite de rate.
MAX_BATCH_SIZE=100

# Configuracion del servidor de la interfaz Streamlit.
STREAMLIT_PORT=8501


# ─── LOCAL ─────────────────────────────────────────────────
# Entorno: local | oci
APP_ENV=local
LOG_LEVEL=INFO
